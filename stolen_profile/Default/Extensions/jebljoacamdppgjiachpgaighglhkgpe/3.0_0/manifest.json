{
   "action": {
      "default_icon": {
         "19": "icon19.png",
         "38": "icon38.png"
      },
      "default_title": "AnyList Recipe Import"
   },
   "author": "AnyList",
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content-script.js" ],
      "matches": [ "https://www.anylist.com/*" ],
      "run_at": "document_start"
   } ],
   "description": "Import recipes from popular websites and blogs directly into AnyList.",
   "icons": {
      "128": "extension-icon128.png",
      "16": "extension-icon16.png",
      "48": "extension-icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "AnyList Recipe Import",
   "permissions": [ "activeTab", "scripting", "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.0"
}
