# Copy to deploy/config and fill in your values before running any build/deploy script.
DOMAIN=browserbleed.yourdomain.com
ENCRYPTION_KEY=                    # 64-char hex AES-256 key - generate with: openssl rand -hex 32
REPORT_TTL=24h                     # how long reports are kept on the server
BB_API_KEY=                        # same key used for browser login, --exfil-key, and the build agent
